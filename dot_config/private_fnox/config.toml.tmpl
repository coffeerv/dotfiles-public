# Global fnox config (per machine). The age key (~/.config/fnox/age.txt) belongs to THIS machine and is never committed.
# Source of truth: your password manager. Prompt-free local cache: "cache" (age), filled by `secrets-sync`.
if_missing = "warn"
{{ if eq .password_manager "bitwarden" }}
# Unlock first: export BW_SESSION="$(bw unlock --raw)". See https://fnox.jdx.dev/providers/bitwarden
[providers.bw]
type = "bitwarden"
{{- else }}
[providers.op]
type = "1password"
{{- end }}

[providers.cache]
type = "age"
recipients = [{{ output "age-keygen" "-y" (joinPath .chezmoi.homeDir ".config" "fnox" "age.txt") | trim | quote }}]
