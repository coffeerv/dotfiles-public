# 1Password SSH agent: which vaults' keys are offered. Each identity's .pub file picks the
# exact key, so offering several vaults is safe. Generated from .chezmoidata/user.toml.
# Docs: https://developer.1password.com/docs/ssh/agent/config
{{- $vaults := list }}{{ range $id, $i := .identities }}{{ $vaults = append $vaults $i.vault }}{{ end }}
{{- range $v := $vaults | uniq }}

[[ssh-keys]]
vault = {{ $v | quote }}
{{- end }}
