[user]
    email = {{ .identities.personal.email }}
    # Public key inline; the private half lives in the password manager and op-ssh-sign signs with it.
    signingkey = {{ .identities.personal.key }}
[core]
    # The .pub only tells the agent WHICH key to offer (you may have several accounts on the same host).
    sshCommand = {{ template "ssh-cmd" . }} -i {{ template "pubdir" . }}/id_personal.pub -o IdentitiesOnly=yes
[gpg]
    format = ssh
[commit]
    gpgsign = true
