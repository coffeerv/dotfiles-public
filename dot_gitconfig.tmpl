# Generated from .chezmoidata/user.toml. OS-specific paths (signing program, ssh, gh) live in ~/.gitconfig.os.
[include]
    path = ~/.gitconfig.os

[user]
    name = {{ .name }}
    # No global email: if none of the rules below match, git refuses to commit
    # instead of silently using the wrong identity.
    useConfigOnly = true

# Verify SSH signatures for every identity (git log --show-signature).
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers

# Each identity is selected twice:
#   - by folder, for fresh repos that have no remote yet, and
#   - by remote URL (git >= 2.36), so it also applies to worktrees, /tmp clones, etc.
# Later matches override earlier ones, which is how a host with its own key layers on top.
{{- range $id, $i := .identities }}

# --- {{ $i.label }} ---
[includeIf "{{ template "gitdir" $ }}:~/{{ $.root }}/{{ $id }}/"]
    path = ~/.gitconfig-{{ $id }}
{{- range $n, $h := $i.hosts }}{{ $slug := splitList "." $h.host | first }}
{{- $own := and (gt $n 0) (hasKey $h "key") $h.key (ne $h.key (index $i.hosts 0).key) }}
{{- if $own }}
[includeIf "{{ template "gitdir" $ }}:~/{{ $.root }}/{{ $id }}/{{ $slug }}/"]
    path = ~/.gitconfig-{{ $id }}-{{ $slug }}
{{- end }}
{{- range $p := list (printf "git@%s:%s/**" $h.host $h.owner) (printf "https://*%s/%s/**" $h.host $h.owner) }}
[includeIf "hasconfig:remote.*.url:{{ $p }}"]
    path = ~/.gitconfig-{{ $id }}
{{- if $own }}
[includeIf "hasconfig:remote.*.url:{{ $p }}"]
    path = ~/.gitconfig-{{ $id }}-{{ $slug }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

# Your own git settings (aliases, editor, …); this setup never touches it. Loaded last, so it wins.
[include]
    path = ~/.gitconfig.local
