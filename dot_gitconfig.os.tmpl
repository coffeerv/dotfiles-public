# Generated by chezmoi for {{ .chezmoi.os }}{{ if .wsl }} (WSL){{ end }}. The only file with OS-specific paths.
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- else if eq .chezmoi.os "windows" }}
    program = "{{ .chezmoi.homeDir | replace "\\" "/" }}/AppData/Local/1Password/app/8/op-ssh-sign.exe"
{{- else if .wsl }}
    program = "/mnt/c/Users/{{ .windowsUser }}/AppData/Local/1Password/app/8/op-ssh-sign-wsl.exe"
{{- else }}
    program = "/opt/1Password/op-ssh-sign"
{{- end }}
{{- if or (eq .chezmoi.os "windows") .wsl }}
[core]
    # WSL/Windows: the 1Password agent lives on the Windows side; ssh.exe reaches it through its named pipe.
    sshCommand = {{ template "ssh-cmd" . }}
{{- end }}
{{- if eq .chezmoi.os "windows" }}
    autocrlf = input
{{- end }}
{{- $gh := "~/.local/share/mise/shims/gh" }}{{ if eq .chezmoi.os "windows" }}{{ $gh = "gh" }}{{ end }}
[credential "https://github.com"]
    helper =
    helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !{{ $gh }} auth git-credential
