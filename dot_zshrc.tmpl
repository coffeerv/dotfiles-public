# Minimal on purpose: only what the multi-identity setup needs. Bring your own prompt/framework.

# mise: per-folder tools and settings. fnox: per-folder secrets. Both switch as you cd.
eval "$({{ .chezmoi.homeDir }}/.local/bin/mise activate zsh)"
eval "$(fnox activate zsh)"

# Make sure the password manager CLI can be used (only needed when syncing, not on cd).
secrets_unlock() {
{{- if eq .password_manager "bitwarden" }}
  [[ -n $BW_SESSION ]] || export BW_SESSION="$(bw unlock --raw)" || return 1
{{- else }}
  # With the 1Password app integration `op whoami` always fails; listing vaults triggers Touch ID.
  op vault list &>/dev/null || { print -u2 "1Password: not authorized (is the app locked?)"; return 1; }
{{- end }}
}

# Copy each identity's secrets from the password manager into its local encrypted cache (fnox.local.toml).
# After rotating something: `secrets-sync <id>` (or no argument for all).
typeset -A SECRETS_DIRS=(
{{- range $id, $i := .identities }}
  {{ $id }} ~/{{ $.root }}/{{ $id }}
{{- end }}
)
secrets-sync() {
  secrets_unlock || return 1
  local name dir
  for name in ${@:-${(k)SECRETS_DIRS}}; do
    dir=${SECRETS_DIRS[$name]}
    [[ -n $dir && -f $dir/fnox.toml ]] || { print -u2 "secrets-sync: unknown name or no fnox.toml: $name"; continue; }
    (cd $dir && fnox sync -p cache --local-file --force && chmod 600 fnox.local.toml) && print "$name: synced"
  done
}

# Your own shell config (aliases, prompt, PATH…) goes here; this setup never touches it.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
